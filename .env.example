# ==============================================================================
# MIND REFILL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and update the values.
# NEVER commit secrets, private keys, or API tokens to version control.
# ==============================================================================

# Application Runtime
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL with UTC timezone and UUID extension)
# Transaction pooler URL (e.g. Supabase, Neon, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psychology_platform?schema=public"
# Direct connection for migrations (optional, falls back to DATABASE_URL if omitted)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/psychology_platform?schema=public"

# Session & Security
# Generate using: openssl rand -base64 48
SESSION_SECRET="at-least-32-characters-random-secret-key-change-in-production-environments"
SESSION_COOKIE_NAME="psy_session"
SESSION_COOKIE_MAX_AGE_SECONDS=604800 # 7 days

# Storage Provider (local | s3)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="psychology-platform-private-documents"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Payment Gateway (mock | stripe | razorpay)
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
PAYMENT_API_SECRET=""
PAYMENT_WEBHOOK_SECRET="whsec_mock_test_key"

# AI Provider (mock | openai | gemini)
# Strict adherence: AI NEVER diagnoses clients or determines clinical suitability
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-pro"

# Transactional Email Provider (mock | resend | ses)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="Mind Refill <support@mindrefill.com>"

# Platform Financial & Operational Defaults (Fully Configurable)
DEFAULT_COUNTRY="IN"
DEFAULT_CURRENCY="INR"
DEFAULT_COMMISSION_PERCENT=10
DEFAULT_SETTLEMENT_DAYS=7
DEFAULT_BOOKING_HOLD_MINUTES=15
